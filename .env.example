# Server
PORT=3001
# Bind host: 0.0.0.0 for dev; 127.0.0.1 in prod behind nginx
HOST=0.0.0.0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=lcbird
DB_PASSWORD=
DB_NAME=newsdb
DB_POOL_SIZE=10

# Admin API bearer token (empty = random token generated on each boot, printed to stdout)
ADMIN_TOKEN=

# CORS: comma-separated origins, or * for open
CORS_ORIGINS=*

# Spider (prod has no scrapy — keep disabled there)
SPIDER_ENABLED=true
SCRAPY_DIR=../news
SPIDER_COOLDOWN_MS=10000
