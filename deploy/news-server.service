[Unit]
Description=news-server (Express + MySQL)
After=mysql.service network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/news-server
ExecStart=/usr/local/bin/node --env-file=.env index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
